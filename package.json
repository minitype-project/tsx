{
  "name": "@minitype/tsx",
  "version": "0.1.0",
  "description": "JSX/TSX support for minitype",
  "author": "Yuto Wada",
  "license": "MIT",
  "homepage": "https://typeset.jp",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/minitype-project/tsx.git"
  },
  "bugs": {
    "url": "https://github.com/minitype-project/tsx/issues"
  },
  "keywords": [
    "minitype",
    "typesetting",
    "jsx",
    "tsx",
    "pdf"
  ],
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./jsx-runtime": {
      "types": "./dist/jsx-runtime.d.ts",
      "import": "./dist/jsx-runtime.js",
      "default": "./dist/jsx-runtime.js"
    },
    "./jsx-dev-runtime": {
      "types": "./dist/jsx-dev-runtime.d.ts",
      "import": "./dist/jsx-dev-runtime.js",
      "default": "./dist/jsx-dev-runtime.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc",
    "check": "biome check ./src --write",
    "license": "addlicense -f .license-header.txt -ignore \"src/templates/**\" src/",
    "license:check": "addlicense -check -f .license-header.txt -ignore \"src/templates/**\" src/",
    "changelog": "conventional-changelog -p conventionalcommits -i CHANGELOG.md -s -r 2",
    "prepare": "husky",
    "test": "vitest run",
    "test:watch": "vitest",
    "sample": "cd sample && tsx index.tsx",
    "docs": "tsx scripts/gen-docs.ts"
  },
  "dependencies": {
    "@minitype/minitype": "^0.1.6"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.4",
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@types/node": "^26.4.1",
    "husky": "^9.1.7",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}
